fn add3(a: i32, b: i32, c: i32) -> i32 {
    return a + b + c;
}

fn twice(x: i32) -> i32 {
    return x + x;
}

fn main() {
    let p: i32 = 3i32;
    let q: i32 = 4i32;
    let r: i32 = 5i32;
    let inner: i32 = add3(p, q, r);
    let outer: i32 = twice(inner + q);
    printlnInt(outer + p);
    exit(0i32);
}
