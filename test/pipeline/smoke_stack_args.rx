fn sum10(
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
    f: i32,
    g: i32,
    h: i32,
    i: i32,
    j: i32,
) -> i32 {
    return a + b + c + d + e + f + g + h + i + j;
}

fn main() {
    let value: i32 = sum10(1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32, 9i32, 10i32);
    printlnInt(value);
    exit(0i32);
}
