struct Point { x: i32, y: i32 }

fn test_load_optimization() -> i32 {
    let mut x: i32 = 42;
    let p = &mut x;
    return *p; // Should optimize to Load(..., @x)
}

fn test_store_optimization() -> i32 {
    let mut x: i32 = 0;
    let p = &mut x;
    *p = 100; // Should optimize to Store(..., @x)
    return x;
}

fn test_addr_optimization() -> i32 {
    let mut x: i32 = 10;
    let p = &mut x;
    let q = p; // Should optimize to AddrOf(@x)
    return *q;
}

fn test_memcpy_optimization() -> i32 {
    let mut p1 = Point { x: 1, y: 2 };
    let mut p2 = Point { x: 3, y: 4 };
    
    let ptr1 = &mut p1;
    let ptr2 = &mut p2;
    
    *ptr1 = *ptr2; // Should optimize to Memcopy(@p1, @p2) or individual stores
    
    return p1.x;
}

fn test_mut_ref_local() -> i32 {
    let mut x: i32 = 10;
    let mut y: i32 = 20;
    
    // p points to x
    let mut p = &mut x;
    *p = 11; // Should optimize to x = 11
    
    // p points to y
    p = &mut y;
    *p = 22; // Should optimize to y = 22
    
    return x + y; // Should range 11 + 22 = 33
}

fn test_immutable_binding(p: &mut i32) -> i32 {
    // This should still be optimized as a MutRefParam because 'p' is not mutable.
    *p = 55;
    return *p;
}

fn test_mut_ref_param(mut p: &mut i32) -> i32 {
    let mut x: i32 = 42;
    // Overwrite the parameter 'p' to point to local 'x'
    p = &mut x;
    *p = 100; // Should optimize to x = 100
    return x;
}

fn main() {
    test_load_optimization();
    test_store_optimization();
    test_addr_optimization();
    test_memcpy_optimization();
    test_mut_ref_local();
    
    let mut val: i32 = 0;
    test_mut_ref_param(&mut val);
    
    test_immutable_binding(&mut val);
    exit(0);
}
