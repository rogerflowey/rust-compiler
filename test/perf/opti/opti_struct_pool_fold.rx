struct Cell {
    value: i32,
    next: i32,
    weight: i32,
    tag: i32,
}

fn fold_cell(cell: Cell, carry: i32) -> i32 {
    let base: i32 = cell.value * 3i32 + cell.weight * 5i32 + cell.tag;
    return base ^ (carry + cell.next * 17i32);
}

fn main() {
    let seed: i32 = getInt();
    let mut pool: [Cell; 96] = [Cell { value: 0i32, next: 0i32, weight: 0i32, tag: 0i32 }; 96usize];
    let mut i: i32 = 0i32;
    while i < 96i32 {
        pool[i as usize] = Cell {
            value: seed + i * 19i32,
            next: (i * 7i32 + seed) % 96i32,
            weight: (i * i + 11i32) % 257i32,
            tag: i % 5i32,
        };
        if (pool[i as usize].next < 0i32) {
            pool[i as usize].next = pool[i as usize].next + 96i32;
        }
        i = i + 1i32;
    }
    let mut round: i32 = 0i32;
    let mut cursor: i32 = seed % 96i32;
    if (cursor < 0i32) { cursor = cursor + 96i32; }
    let mut acc: i32 = 0i32;
    while round < 25000i32 {
        let cell: Cell = pool[cursor as usize];
        acc = fold_cell(cell, acc);
        let updated: i32 = (cell.value + acc / 97i32 + round) % 4099i32;
        pool[cursor as usize].value = updated;
        cursor = (cell.next + round + cell.tag) % 96i32;
        if (cursor < 0i32) { cursor = cursor + 96i32; }
        round = round + 1i32;
    }
    printlnInt(acc + pool[cursor as usize].value);
    exit(0i32);
}

