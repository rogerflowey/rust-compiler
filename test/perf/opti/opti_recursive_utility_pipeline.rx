fn combine(a: i32, b: i32, salt: i32) -> i32 {
    let mixed: i32 = a * 31i32 + b * 17i32 + salt;
    return mixed ^ (mixed / 256i32);
}

fn utility_depth(n: i32, salt: i32) -> i32 {
    if (n <= 1i32) {
        return salt + n * 3i32;
    } else {
        let left: i32 = utility_depth(n - 1i32, salt + n);
        let right: i32 = utility_depth(n - 2i32, salt + n / 2i32);
        return combine(left, right, salt + n);
    }
}

fn main() {
    let seed: i32 = getInt();
    let mut data: [i32; 48] = [0i32; 48usize];
    let mut i: i32 = 0i32;
    while i < 48i32 {
        data[i as usize] = seed + i * 7i32 + utility_depth(5i32 + (i % 4i32), seed % 23i32);
        i = i + 1i32;
    }
    let mut round: i32 = 0i32;
    let mut acc: i32 = 0i32;
    while round < 220i32 {
        let pos: i32 = (round * 11i32 + seed) % 48i32;
        let mut idx: i32 = pos;
        if (idx < 0i32) {
            idx = idx + 48i32;
        }
        let value: i32 = data[idx as usize];
        let extra: i32 = utility_depth(6i32 + (round % 3i32), value % 19i32);
        data[idx as usize] = combine(value, extra, round);
        acc = acc + data[idx as usize] / 3i32 + extra;
        round = round + 1i32;
    }
    printlnInt(acc);
    exit(0i32);
}
