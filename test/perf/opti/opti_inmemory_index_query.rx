fn hash_key(key: i32) -> i32 {
    let h: i32 = key * 1103i32 + (key / 17i32) * 97i32 + 53i32;
    let r: i32 = h % 257i32;
    if (r < 0i32) { return r + 257i32; } else { return r; }
}

fn main() {
    let seed: i32 = getInt();
    let mut keys: [i32; 257] = [0i32; 257usize];
    let mut vals: [i32; 257] = [0i32; 257usize];
    let mut used: [i32; 257] = [0i32; 257usize];
    let mut i: i32 = 0i32;
    while i < 180i32 {
        let key: i32 = seed * 1000i32 + i * 37i32 + (i % 13i32);
        let mut slot: i32 = hash_key(key);
        while used[slot as usize] != 0i32 {
            slot = (slot + 1i32) % 257i32;
        }
        used[slot as usize] = 1i32;
        keys[slot as usize] = key;
        vals[slot as usize] = i * i + seed;
        i = i + 1i32;
    }
    let mut q: i32 = 0i32;
    let mut checksum: i32 = 0i32;
    while q < 60000i32 {
        let wanted_id: i32 = (q * 19i32 + seed) % 180i32;
        let key: i32 = seed * 1000i32 + wanted_id * 37i32 + (wanted_id % 13i32);
        let mut slot: i32 = hash_key(key);
        let mut searching: i32 = 1i32;
        while searching != 0i32 {
            if (used[slot as usize] == 0i32) {
                searching = 0i32;
            } else {
                if (keys[slot as usize] == key) {
                    searching = 0i32;
                } else {
                    slot = (slot + 1i32) % 257i32;
                }
            }
        }
        if (used[slot as usize] != 0i32) {
            checksum = checksum + vals[slot as usize] + slot;
        } else {
            checksum = checksum - q;
        }
        q = q + 1i32;
    }
    printlnInt(checksum);
    exit(0i32);
}
