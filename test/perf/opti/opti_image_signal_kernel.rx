fn pixel_index(row: i32, col: i32) -> usize {
    return (row * 16i32 + col) as usize;
}

fn clamp(value: i32, limit: i32) -> i32 {
    if (value < 0i32) {
        return 0i32;
    } else {
        if (value >= limit) { return limit - 1i32; } else { return value; }
    }
}

fn main() {
    let seed: i32 = getInt();
    let mut src: [i32; 256] = [0i32; 256usize];
    let mut tmp: [i32; 256] = [0i32; 256usize];
    let mut dst: [i32; 256] = [0i32; 256usize];
    let mut r: i32 = 0i32;
    while r < 16i32 {
        let mut c: i32 = 0i32;
        while c < 16i32 {
            src[pixel_index(r, c)] = (seed + r * 29i32 + c * 17i32 + r * c) % 256i32;
            c = c + 1i32;
        }
        r = r + 1i32;
    }
    let mut pass: i32 = 0i32;
    while pass < 280i32 {
        r = 0i32;
        while r < 16i32 {
            let mut c: i32 = 0i32;
            while c < 16i32 {
                let left: i32 = src[pixel_index(r, clamp(c - 1i32, 16i32))];
                let mid: i32 = src[pixel_index(r, c)];
                let right: i32 = src[pixel_index(r, clamp(c + 1i32, 16i32))];
                tmp[pixel_index(r, c)] = (left + mid * 2i32 + right) / 4i32;
                c = c + 1i32;
            }
            r = r + 1i32;
        }
        r = 0i32;
        while r < 16i32 {
            let mut c: i32 = 0i32;
            while c < 16i32 {
                let up: i32 = tmp[pixel_index(clamp(r - 1i32, 16i32), c)];
                let mid: i32 = tmp[pixel_index(r, c)];
                let down: i32 = tmp[pixel_index(clamp(r + 1i32, 16i32), c)];
                dst[pixel_index(r, c)] = (up + mid * 2i32 + down + pass % 7i32) / 4i32;
                c = c + 1i32;
            }
            r = r + 1i32;
        }
        r = 0i32;
        while r < 256i32 {
            src[r as usize] = dst[r as usize];
            r = r + 1i32;
        }
        pass = pass + 1i32;
    }
    let mut checksum: i32 = 0i32;
    r = 0i32;
    while r < 256i32 {
        checksum = checksum + dst[r as usize] * ((r % 13i32) + 1i32);
        r = r + 1i32;
    }
    printlnInt(checksum);
    exit(0i32);
}

