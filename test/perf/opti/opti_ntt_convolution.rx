fn mod_norm(value: i32) -> i32 {
    let r: i32 = value % 12289i32;
    if (r < 0i32) { return r + 12289i32; } else { return r; }
}

fn mod_pow(base: i32, exp: i32) -> i32 {
    let mut result: i32 = 1i32;
    let mut b: i32 = mod_norm(base);
    let mut e: i32 = exp;
    while e > 0i32 {
        if (e % 2i32 == 1i32) {
            result = mod_norm(result * b);
        }
        b = mod_norm(b * b);
        e = e / 2i32;
    }
    return result;
}

fn main() {
    let seed: i32 = getInt();
    let mut a: [i32; 64] = [0i32; 64usize];
    let mut b: [i32; 64] = [0i32; 64usize];
    let mut i: i32 = 0i32;
    while i < 64i32 {
        a[i as usize] = mod_norm(seed + i * 17i32 + i * i);
        b[i as usize] = mod_norm(seed * 3i32 + i * 29i32 + 7i32);
        i = i + 1i32;
    }
    let root: i32 = mod_pow(11i32, 192i32);
    let mut out: [i32; 64] = [0i32; 64usize];
    let mut row: i32 = 0i32;
    while row < 64i32 {
        let mut col: i32 = 0i32;
        let mut w: i32 = 1i32;
        let step: i32 = mod_pow(root, row);
        while col < 64i32 {
            let product: i32 = mod_norm(a[col as usize] * b[((row - col + 64i32) % 64i32) as usize]);
            out[row as usize] = mod_norm(out[row as usize] + product * w);
            w = mod_norm(w * step);
            col = col + 1i32;
        }
        row = row + 1i32;
    }
    let mut checksum: i32 = 0i32;
    i = 0i32;
    while i < 64i32 {
        checksum = mod_norm(checksum + out[i as usize] * (i + 1i32));
        i = i + 1i32;
    }
    printlnInt(checksum);
    exit(0i32);
}

