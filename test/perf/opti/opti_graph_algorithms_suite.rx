fn edge_index(row: i32, col: i32) -> usize {
    return (row * 12i32 + col) as usize;
}

fn main() {
    let seed: i32 = getInt();
    let mut graph: [i32; 144] = [0i32; 144usize];
    let mut r: i32 = 0i32;
    while r < 12i32 {
        let mut c: i32 = 0i32;
        while c < 12i32 {
            if (r == c) {
                graph[edge_index(r, c)] = 0i32;
            } else {
                graph[edge_index(r, c)] = ((r + 3i32) * (c + 5i32) + seed) % 97i32 + 1i32;
            }
            c = c + 1i32;
        }
        r = r + 1i32;
    }
    let mut k: i32 = 0i32;
    while k < 12i32 {
        r = 0i32;
        while r < 12i32 {
            let mut c: i32 = 0i32;
            while c < 12i32 {
                let through: i32 = graph[edge_index(r, k)] + graph[edge_index(k, c)];
                if (through < graph[edge_index(r, c)]) {
                    graph[edge_index(r, c)] = through;
                }
                c = c + 1i32;
            }
            r = r + 1i32;
        }
        k = k + 1i32;
    }
    let mut checksum: i32 = 0i32;
    r = 0i32;
    while r < 12i32 {
        let target: i32 = (r * 7i32 + seed) % 12i32;
        checksum = checksum + graph[edge_index(r, target)] * (r + 1i32);
        r = r + 1i32;
    }
    printlnInt(checksum);
    exit(0i32);
}

